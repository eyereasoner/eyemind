{
  "name": "eyemind",
  "version": "0.5.3",
  "description": "A dependency-free JavaScript rule language with forward and backward reasoning and checkable proofs.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "eyemind": "bin/eyemind.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "SPEC.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node test/run.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "reasoner",
    "rules",
    "logic",
    "proof",
    "datalog"
  ],
  "author": "Jos De Roo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyereasoner/eyemind.git"
  },
  "homepage": "https://eyereasoner.github.io/eyemind/",
  "publishConfig": {
    "access": "public"
  }
}
