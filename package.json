{
  "name": "eyemind",
  "version": "0.6.1",
  "description": "A dependency-free Logic Script (LS) reasoner with forward and backward reasoning, checkable proofs, and RDF 1.2, Notation3 (N3) and SPARQL 1.2 RL (SRL) interoperability.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "eyemind": "bin/eyemind.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "SPEC.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node test/run.js",
    "sync": "node tools/sync.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "reasoner",
    "rules",
    "logic",
    "logic-script",
    "javascript",
    "proof",
    "datalog"
  ],
  "author": "Jos De Roo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyereasoner/eyemind.git"
  },
  "homepage": "https://eyereasoner.github.io/eyemind/",
  "publishConfig": {
    "access": "public"
  }
}
