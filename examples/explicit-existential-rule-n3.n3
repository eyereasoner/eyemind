# A universally quantified rule with explicitly named mothers
#
# A rule says that each human has some mother, and Tom and Ann are humans.
# Explicit @forAll declarations name its two rule variables; log:skolem
# computes the mother IRI from the person. Tom and Ann receive different
# mother IRIs. Both variables are bound in the premise, so the proof checks
# strictly without a restricted existential firing.

@prefix : <http://example.org/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# The universal :x matches a human; the universal :y receives the computed IRI.
@forAll :x .
@forAll :y .
{
    :x a :Human .
    (:mother :x) log:skolem :y
} => {
    :x :hasMother :y
} .

# The humans.
:tom a :Human .
:ann a :Human .
