# Paid orders ship only when no hold is on record. An unverified address
# derives a hold for order 2, so only order 1 ships. The shipping rule is
# written first to show that stratification settles holds before negation.
@prefix : <https://example.org/orders#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

:order1 :status :paid .
:order2 :status :paid ; :address :unverified .
:order3 :status :open .

{
  ?order :status :paid .
  [] log:notIncludes { ?order :hold ?reason } .
} => { ?order :action :ship } .

{ ?order :address :unverified } => { ?order :hold :addressCheck } .
