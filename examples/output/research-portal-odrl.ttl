PREFIX : <https://example.org/research-portal#>
PREFIX eval: <https://eyereasoner.github.io/eyemind/odrl#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>

:evaluation a eval:EvaluationReport .
:evaluation eval:policy :policy .
:evaluation eval:conflictStrategy odrl:prohibit .
:r1 a eval:Request .
:r1 odrl:assignee :consortium .
:r1 odrl:action odrl:use .
:r1 odrl:target :labResults .
:r1 eval:subject :patients .
:r1 eval:state :r1State .
:r2 a eval:Request .
:r2 odrl:assignee :consortium .
:r2 odrl:action odrl:use .
:r2 odrl:target :labResults .
:r2 eval:subject :patients .
:r2 eval:state :r2State .
:r3 a eval:Request .
:r3 odrl:assignee :consortium .
:r3 odrl:action odrl:distribute .
:r3 odrl:target :labResults .
:r3 eval:subject :patients .
:r3 eval:state :r3State .
:r4 a eval:Request .
:r4 odrl:assignee :consortium .
:r4 odrl:action odrl:use .
:r4 odrl:target :labResults .
:r4 eval:subject :patients .
:r4 eval:state :r4State .
:r5 a eval:Request .
:r5 odrl:assignee :consortium .
:r5 odrl:action odrl:use .
:r5 odrl:target :labResults .
:r5 eval:subject :patients .
:r5 eval:state :r5State .
:r6 a eval:Request .
:r6 odrl:assignee :consortium .
:r6 odrl:action odrl:use .
:r6 odrl:target :labResults .
:r6 eval:subject :patients .
:r6 eval:state :r6State .
:r11 a eval:Request .
:r11 odrl:assignee :consortium .
:r11 odrl:action odrl:distribute .
:r11 odrl:target :labResults .
:r11 eval:subject :patients .
:r11 eval:state :r11State .
:evaluation eval:validationStatus eval:Valid .
:r2 eval:unmetConstraint :forResearch .
:r2 eval:unmetConstraint :underConsent .
:r2 eval:unmetConstraint :consentGiven .
:r4 eval:unmetConstraint :consentGiven .
:r5 eval:unmetConstraint :pseudonymised .
:r5 eval:unmetConstraint :before2027 .
:r11 eval:unmetConstraint :forMarketing .
:r1 eval:unmetConstraint :toUS .
:r2 eval:unmetConstraint :toUS .
:r4 eval:unmetConstraint :toUS .
:r5 eval:unmetConstraint :toUS .
:r1 eval:permission :research .
:r6 eval:permission :research .
:r3 eval:prohibition :noMarketing .
:r6 eval:prohibition :noTransferUS .
:evaluation eval:conflict _:b0 .
_:b0 a eval:Conflict .
_:b0 eval:request :r6 .
_:b0 eval:permissionPolicy :policy .
_:b0 eval:permissionRule :research .
_:b0 eval:prohibitionPolicy :policy .
_:b0 eval:prohibitionRule :noTransferUS .
:evaluation eval:conflictCount 1 .
:evaluation eval:request :r1 .
:r1 eval:decision eval:Allowed .
:evaluation eval:request :r3 .
:r3 eval:decision eval:Prohibited .
:evaluation eval:request :r6 .
:r6 eval:decision eval:Prohibited .
:evaluation eval:request :r2 .
:r2 eval:decision eval:NotApplicable .
:evaluation eval:request :r4 .
:r4 eval:decision eval:NotApplicable .
:evaluation eval:request :r5 .
:r5 eval:decision eval:NotApplicable .
:evaluation eval:request :r11 .
:r11 eval:decision eval:NotApplicable .
:evaluation eval:canHappen :r1 .
