PREFIX : <https://example.org/package-holiday#>
PREFIX eval: <https://eyereasoner.github.io/eyemind/odrl#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX sh: <http://www.w3.org/ns/shacl#>

_:b0 a sh:ValidationReport .
_:b0 sh:conforms true .
:evaluation a eval:EvaluationReport .
:evaluation eval:policy :terms .
:evaluation eval:conflictStrategy odrl:prohibit .
:r1 a eval:Request .
:r1 odrl:assignee :traveller .
:r1 odrl:action :cancel .
:r1 odrl:target :package .
:r1 eval:subject :bk1 .
:r1 eval:state :r1State .
:r2 a eval:Request .
:r2 odrl:assignee :traveller .
:r2 odrl:action :cancel .
:r2 odrl:target :package .
:r2 eval:subject :bk2 .
:r2 eval:state :r2State .
:r3 a eval:Request .
:r3 odrl:assignee :traveller .
:r3 odrl:action :cancel .
:r3 odrl:target :package .
:r3 eval:subject :bk3 .
:r3 eval:state :r3State .
:r4 a eval:Request .
:r4 odrl:assignee :traveller .
:r4 odrl:action :cancel .
:r4 odrl:target :package .
:r4 eval:subject :bk4 .
:r4 eval:state :r4State .
:r5 a eval:Request .
:r5 odrl:assignee :traveller .
:r5 odrl:action :cancel .
:r5 odrl:target :package .
:r5 eval:subject :bk5 .
:r5 eval:state :r5State .
:r6 a eval:Request .
:r6 odrl:assignee :traveller .
:r6 odrl:action :cancel .
:r6 odrl:target :package .
:r6 eval:subject :bk6 .
:r6 eval:state :r6State .
:r7 a eval:Request .
:r7 odrl:assignee :traveller .
:r7 odrl:action :cancel .
:r7 odrl:target :package .
:r7 eval:subject :bk7 .
:r7 eval:state :r7State .
:r8 a eval:Request .
:r8 odrl:assignee :traveller .
:r8 odrl:action :cancel .
:r8 odrl:target :package .
:r8 eval:subject :bk8 .
:r8 eval:state :r8State .
:evaluation eval:validationStatus eval:Valid .
:r7 eval:unmetConstraint :conditions .
:r8 eval:unmetConstraint :conditions .
:r1 eval:permission :cancellation .
:r2 eval:permission :cancellation .
:r3 eval:permission :cancellation .
:r4 eval:permission :cancellation .
:r5 eval:permission :cancellation .
:r6 eval:permission :cancellation .
:evaluation eval:conflictCount 0 .
:evaluation eval:request :r1 .
:r1 eval:decision eval:Allowed .
:evaluation eval:request :r2 .
:r2 eval:decision eval:Allowed .
:evaluation eval:request :r3 .
:r3 eval:decision eval:Allowed .
:evaluation eval:request :r4 .
:r4 eval:decision eval:Allowed .
:evaluation eval:request :r5 .
:r5 eval:decision eval:Allowed .
:evaluation eval:request :r6 .
:r6 eval:decision eval:Allowed .
:evaluation eval:request :r7 .
:r7 eval:decision eval:NotApplicable .
:evaluation eval:request :r8 .
:r8 eval:decision eval:NotApplicable .
:evaluation eval:canHappen :r1 .
:evaluation eval:canHappen :r2 .
:evaluation eval:canHappen :r3 .
:evaluation eval:canHappen :r4 .
:evaluation eval:canHappen :r5 .
:evaluation eval:canHappen :r6 .
