PREFIX : <https://example.org/people#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

:Alice a :Employee .
:Bob a :Person .
:Alice a :Person .
:Researcher rdfs:subClassOf :Person .
:Alice :knows :Bob .
:colleague rdfs:domain :Person .
rdf:type a rdf:Property .
rdfs:subClassOf a rdf:Property .
:knows a rdf:Property .
rdfs:domain a rdf:Property .
rdfs:subPropertyOf a rdf:Property .
rdfs:range a rdf:Property .
:colleague a rdf:Property .
:Alice a rdfs:Resource .
:Employee a rdfs:Resource .
:Bob a rdfs:Resource .
:Person a rdfs:Resource .
:Researcher a rdfs:Resource .
:colleague a rdfs:Resource .
rdf:type a rdfs:Resource .
rdf:Property a rdfs:Resource .
rdfs:subClassOf a rdfs:Resource .
:knows a rdfs:Resource .
rdfs:domain a rdfs:Resource .
rdfs:subPropertyOf a rdfs:Resource .
rdfs:range a rdfs:Resource .
:Employee a rdfs:Class .
:Person a rdfs:Class .
rdf:Property a rdfs:Class .
rdfs:Resource a rdfs:Class .
:Researcher a rdfs:Class .
rdf:type rdfs:subPropertyOf rdf:type .
rdfs:subClassOf rdfs:subPropertyOf rdfs:subClassOf .
:knows rdfs:subPropertyOf :knows .
rdfs:domain rdfs:subPropertyOf rdfs:domain .
rdfs:subPropertyOf rdfs:subPropertyOf rdfs:subPropertyOf .
rdfs:range rdfs:subPropertyOf rdfs:range .
:colleague rdfs:subPropertyOf :colleague .
:Employee rdfs:subClassOf :Employee .
:Employee rdfs:subClassOf rdfs:Resource .
:Person rdfs:subClassOf :Person .
:Person rdfs:subClassOf rdfs:Resource .
rdf:Property rdfs:subClassOf rdf:Property .
rdf:Property rdfs:subClassOf rdfs:Resource .
rdfs:Resource rdfs:subClassOf rdfs:Resource .
:Researcher rdfs:subClassOf :Researcher .
:Researcher rdfs:subClassOf rdfs:Resource .
:colleague rdfs:domain rdfs:Resource .
:colleague rdfs:range rdfs:Resource .
rdfs:Resource a rdfs:Resource .
rdfs:Class a rdfs:Resource .
rdfs:Class a rdfs:Class .
rdfs:Class rdfs:subClassOf rdfs:Class .
rdfs:Class rdfs:subClassOf rdfs:Resource .
