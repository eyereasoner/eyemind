witness(rule 360, "Issue", ex:eraseBackups, ex:retentionRuns, ex:keepBackups, ex:retentionYearsLeft, eval:MissingObservation) is an uncertainty.
witness(rule 360, "Issue", ex:eraseBackups, ex:retentionRuns, ex:keepBackups, ex:retentionYearsLeft, eval:MissingObservation) has reportConstraint retentionRuns.
witness(rule 360, "Issue", ex:eraseBackups, ex:retentionRuns, ex:keepBackups, ex:retentionYearsLeft, eval:MissingObservation) has rule keepBackups.
witness(rule 360, "Issue", ex:eraseBackups, ex:retentionRuns, ex:keepBackups, ex:retentionYearsLeft, eval:MissingObservation) has property retentionYearsLeft.
witness(rule 360, "Issue", ex:eraseBackups, ex:retentionRuns, ex:keepBackups, ex:retentionYearsLeft, eval:MissingObservation) has reason eval:MissingObservation.
