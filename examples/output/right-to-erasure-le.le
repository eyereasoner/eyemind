witness(rule 364, "Conflict", ex:evaluation, ex:eraseTickets, ex:retentionPolicy, ex:mayEraseTickets, ex:retentionPolicy, ex:keepTickets) has permissionPolicy retentionPolicy.
witness(rule 364, "Conflict", ex:evaluation, ex:eraseTickets, ex:retentionPolicy, ex:mayEraseTickets, ex:retentionPolicy, ex:keepTickets) has permissionRule mayEraseTickets.
