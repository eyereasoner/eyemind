witness(rule 364, "Conflict", ex:evaluation, ex:eraseInvoices, ex:retentionPolicy, ex:mayEraseInvoices, ex:retentionPolicy, ex:keepInvoices) has request eraseInvoices.
witness(rule 364, "Conflict", ex:evaluation, ex:eraseInvoices, ex:retentionPolicy, ex:mayEraseInvoices, ex:retentionPolicy, ex:keepInvoices) has permissionPolicy retentionPolicy.
witness(rule 364, "Conflict", ex:evaluation, ex:eraseInvoices, ex:retentionPolicy, ex:mayEraseInvoices, ex:retentionPolicy, ex:keepInvoices) has permissionRule mayEraseInvoices.
