PREFIX : <https://example.org/research-access#>
PREFIX eval: <https://eyereasoner.github.io/eyemind/odrl#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>

:evaluation a eval:EvaluationReport .
:evaluation eval:policy :policy .
:evaluation eval:conflictStrategy odrl:prohibit .
:study a eval:Request .
:study odrl:assignee :partner .
:study odrl:action odrl:use .
:study odrl:target :dataset .
:study eval:subject :participants .
:study eval:state :studyState .
:study eval:fulfilledDuty :credit .
:mixed a eval:Request .
:mixed odrl:assignee :partner .
:mixed odrl:action odrl:use .
:mixed odrl:target :dataset .
:mixed eval:subject :participants .
:mixed eval:state :mixedState .
:mixed eval:fulfilledDuty :credit .
:pending a eval:Request .
:pending odrl:assignee :partner .
:pending odrl:action odrl:use .
:pending odrl:target :dataset .
:pending eval:subject :participants .
:pending eval:state :pendingState .
:evaluation eval:validationStatus eval:Valid .
:pending eval:uncertainty _:b0 .
_:b0 a eval:Uncertainty .
_:b0 eval:duty :credit .
_:b0 eval:rule :research .
_:b0 eval:reason eval:MissingDutyEvidence .
:study eval:unmetConstraint :marketing .
:pending eval:unmetConstraint :marketing .
:study eval:permission :research .
:mixed eval:permission :research .
:mixed eval:prohibition :noMarketing .
:evaluation eval:conflict _:b1 .
_:b1 a eval:Conflict .
_:b1 eval:request :mixed .
_:b1 eval:permissionPolicy :policy .
_:b1 eval:permissionRule :research .
_:b1 eval:prohibitionPolicy :policy .
_:b1 eval:prohibitionRule :noMarketing .
:evaluation eval:conflictCount 1 .
:evaluation eval:request :pending .
:pending eval:decision eval:Undetermined .
:evaluation eval:request :study .
:study eval:decision eval:Allowed .
:evaluation eval:request :mixed .
:mixed eval:decision eval:Prohibited .
:evaluation eval:canHappen :study .
