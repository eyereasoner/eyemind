marketing has action "iri"("http://www.w3.org/ns/odrl/2/use").
marketing has target directory.
marketing has subject visitor.
marketing has state marketingState.
marketing has fulfilledDuty credit.
evaluation has validationStatus valid.
pending has uncertainty witness(rule 286, "Issue", "iri"("https://example.org/research-snapshot#pending"), "iri"("https://example.org/research-snapshot#credit"), "iri"("https://example.org/research-snapshot#researchUse"), "iri"("https://eyereasoner.github.io/eyemind/odrl#MissingDutyEvidence")).
witness(rule 286, "Issue", "iri"("https://example.org/research-snapshot#pending"), "iri"("https://example.org/research-snapshot#credit"), "iri"("https://example.org/research-snapshot#researchUse"), "iri"("https://eyereasoner.github.io/eyemind/odrl#MissingDutyEvidence")) is an uncertainty.
witness(rule 286, "Issue", "iri"("https://example.org/research-snapshot#pending"), "iri"("https://example.org/research-snapshot#credit"), "iri"("https://example.org/research-snapshot#researchUse"), "iri"("https://eyereasoner.github.io/eyemind/odrl#MissingDutyEvidence")) has reportDuty credit.
witness(rule 286, "Issue", "iri"("https://example.org/research-snapshot#pending"), "iri"("https://example.org/research-snapshot#credit"), "iri"("https://example.org/research-snapshot#researchUse"), "iri"("https://eyereasoner.github.io/eyemind/odrl#MissingDutyEvidence")) has rule researchUse.
witness(rule 286, "Issue", "iri"("https://example.org/research-snapshot#pending"), "iri"("https://example.org/research-snapshot#credit"), "iri"("https://example.org/research-snapshot#researchUse"), "iri"("https://eyereasoner.github.io/eyemind/odrl#MissingDutyEvidence")) has reason "iri"("https://eyereasoner.github.io/eyemind/odrl#MissingDutyEvidence").
