# N3 proof: claims, steps and the complete C1–C10 certificate.
@prefix : <https://example.org/family#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix em: <https://eyereasoner.github.io/eyemind/proof#> .
@prefix proof: <urn:eyemind:proof#> .

<urn:eyemind:proof> a pe:Proof .
<urn:eyemind:proof> em:format "n3" .
<urn:eyemind:proof> pe:claims ({ :ann :ancestor :bob } { :ann :ancestor :cara }) .
proof:record8 pe:conclusion { :ann :ancestor :bob } .
proof:record8 pe:rule 5 .
proof:record8 pe:binding (("Who" :bob)) .
proof:record8 pe:uses ({ :ann :ancestor :bob }) .
proof:record9 pe:conclusion { :ann :ancestor :bob } .
proof:record9 pe:rule 3 .
proof:record9 pe:binding (("Person" :ann) ("Descendant" :bob)) .
proof:record9 pe:uses ({ :ann :parent :bob }) .
proof:record10 pe:conclusion { :ann :parent :bob } .
proof:record10 pe:rule 1 .
proof:record10 pe:binding () .
proof:record10 pe:uses () .
proof:record11 pe:conclusion { :ann :ancestor :cara } .
proof:record11 pe:rule 5 .
proof:record11 pe:binding (("Who" :cara)) .
proof:record11 pe:uses ({ :ann :ancestor :cara }) .
proof:record12 pe:conclusion { :ann :ancestor :cara } .
proof:record12 pe:rule 4 .
proof:record12 pe:binding (("Person" :ann) ("Descendant" :cara) ("Child" :bob)) .
proof:record12 pe:uses ({ :ann :parent :bob } { :bob :ancestor :cara }) .
proof:record13 pe:conclusion { :bob :ancestor :cara } .
proof:record13 pe:rule 3 .
proof:record13 pe:binding (("Person" :bob) ("Descendant" :cara)) .
proof:record13 pe:uses ({ :bob :parent :cara }) .
proof:record14 pe:conclusion { :bob :parent :cara } .
proof:record14 pe:rule 2 .
proof:record14 pe:binding () .
proof:record14 pe:uses () .
proof:record15 pe:derived { ?A ?B ?C } .
proof:record15 pe:answers ({ :ann :ancestor :bob } { :ann :ancestor :cara }) .
proof:record16 pe:called { ?A ?B ?C } .
proof:record16 pe:answers ({ :ann :ancestor :bob } { :ann :ancestor :cara }) .
proof:record17 pe:called { :ann :ancestor ?D } .
proof:record17 pe:answers ({ :ann :ancestor :bob } { :ann :ancestor :cara }) .
proof:record18 pe:called { :ann :parent ?E } .
proof:record18 pe:answers ({ :ann :parent :bob }) .
proof:record19 pe:called { :bob :ancestor ?F } .
proof:record19 pe:answers ({ :bob :ancestor :cara }) .
proof:record20 pe:called { :bob :parent ?G } .
proof:record20 pe:answers ({ :bob :parent :cara }) .
proof:record21 pe:called { :cara :ancestor ?H } .
proof:record21 pe:answers () .
proof:record22 pe:called { :cara :parent ?I } .
proof:record22 pe:answers () .
<urn:eyemind:proof> em:records (proof:record1 proof:record2 proof:record3 proof:record4 proof:record5 proof:record6 proof:record7 proof:record8 proof:record9 proof:record10 proof:record11 proof:record12 proof:record13 proof:record14 proof:record15 proof:record16 proof:record17 proof:record18 proof:record19 proof:record20 proof:record21 proof:record22) .
