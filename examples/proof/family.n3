proof:record2 em:term (em:compound "result" ((em:iri :ann) (em:iri :ancestor) (em:iri :cara))) .
proof:record3 em:term (em:compound "clause" ((em:integer "1") (em:compound "fact" ((em:compound "rdf" ((em:iri :ann) (em:iri :parent) (em:iri :bob))))))) .
