# N3 proof: claims, steps and the complete C1–C10 certificate.
@prefix : <https://example.org/orders#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix em: <https://eyereasoner.github.io/eyemind/proof#> .
@prefix proof: <urn:eyemind:proof#> .

<urn:eyemind:proof> a pe:Proof .
<urn:eyemind:proof> em:format "n3" .
<urn:eyemind:proof> pe:claims ({ :order2 :hold :addressCheck } { :order1 :action :ship }) .
proof:record7 pe:conclusion { :order2 :hold :addressCheck } .
proof:record7 pe:rule 6 .
proof:record7 pe:binding (("Order" :order2)) .
proof:record7 pe:uses ({ :order2 :address :unverified }) .
proof:record8 pe:conclusion { :order2 :address :unverified } .
proof:record8 pe:rule 3 .
proof:record8 pe:binding () .
proof:record8 pe:uses () .
proof:record9 pe:conclusion { :order1 :action :ship } .
proof:record9 pe:rule 5 .
proof:record9 pe:binding (("Order" :order1) ("_1" ?A)) .
proof:record9 pe:uses ({ :order1 :status :paid } (em:compound "not" ((em:compound "rdf" ((em:iri :order1) (em:iri :hold) (em:variable "A")))))) .
proof:record10 pe:conclusion { :order1 :status :paid } .
proof:record10 pe:rule 1 .
proof:record10 pe:binding () .
proof:record10 pe:uses () .
proof:record11 pe:conclusion (em:compound "not" ((em:compound "rdf" ((em:iri :order1) (em:iri :hold) (em:variable "A"))))) .
proof:record11 pe:justification (em:atom "absent") .
proof:record11 pe:binding () .
proof:record11 pe:uses () .
proof:record12 pe:derived { ?B ?C ?D } .
proof:record12 pe:answers ({ :order2 :hold :addressCheck } { :order1 :action :ship }) .
proof:record13 pe:searched { :order1 :hold ?E } .
proof:record13 pe:answers () .
proof:record14 pe:searched { ?F :status :paid } .
proof:record14 pe:answers ({ :order1 :status :paid } { :order2 :status :paid }) .
proof:record15 pe:searched { :order2 :hold ?G } .
proof:record15 pe:answers ({ :order2 :hold :addressCheck }) .
proof:record16 pe:searched { ?H :address :unverified } .
proof:record16 pe:answers ({ :order2 :address :unverified }) .
<urn:eyemind:proof> em:records (proof:record1 proof:record2 proof:record3 proof:record4 proof:record5 proof:record6 proof:record7 proof:record8 proof:record9 proof:record10 proof:record11 proof:record12 proof:record13 proof:record14 proof:record15 proof:record16) .
proof:record1 em:term (em:compound "rdf" ((em:iri :order2) (em:iri :hold) (em:iri :addressCheck))) .
proof:record2 em:term (em:compound "rdf" ((em:iri :order1) (em:iri :action) (em:iri :ship))) .
proof:record3 em:term (em:compound "clause" ((em:integer "1") (em:compound "fact" ((em:compound "rdf" ((em:iri :order1) (em:iri :status) (em:iri :paid))))))) .
proof:record4 em:term (em:compound "clause" ((em:integer "3") (em:compound "fact" ((em:compound "rdf" ((em:iri :order2) (em:iri :address) (em:iri :unverified))))))) .
proof:record5 em:term (em:compound "clause" ((em:integer "5") (em:compound "implies" ((em:list ((em:compound "rdf" ((em:variable "Order") (em:iri :status) (em:iri :paid))) (em:compound "not" ((em:compound "rdf" ((em:variable "Order") (em:iri :hold) (em:variable "_1"))))))) (em:compound "rdf" ((em:variable "Order") (em:iri :action) (em:iri :ship))))))) .
proof:record6 em:term (em:compound "clause" ((em:integer "6") (em:compound "implies" ((em:compound "rdf" ((em:variable "Order") (em:iri :address) (em:iri :unverified))) (em:compound "rdf" ((em:variable "Order") (em:iri :hold) (em:iri :addressCheck))))))) .
proof:record7 em:term (em:compound "step" ((em:compound "rdf" ((em:iri :order2) (em:iri :hold) (em:iri :addressCheck))) (em:compound "clause" ((em:integer "6"))) (em:list ((em:compound "=" ((em:atom "Order") (em:iri :order2))))) (em:list ((em:compound "rdf" ((em:iri :order2) (em:iri :address) (em:iri :unverified))))))) .
proof:record8 em:term (em:compound "step" ((em:compound "rdf" ((em:iri :order2) (em:iri :address) (em:iri :unverified))) (em:compound "clause" ((em:integer "3"))) (em:atom "[]") (em:atom "[]"))) .
proof:record9 em:term (em:compound "step" ((em:compound "rdf" ((em:iri :order1) (em:iri :action) (em:iri :ship))) (em:compound "clause" ((em:integer "5"))) (em:list ((em:compound "=" ((em:atom "Order") (em:iri :order1))) (em:compound "=" ((em:atom "_1") (em:variable "A"))))) (em:list ((em:compound "rdf" ((em:iri :order1) (em:iri :status) (em:iri :paid))) (em:compound "not" ((em:compound "rdf" ((em:iri :order1) (em:iri :hold) (em:variable "A"))))))))) .
proof:record10 em:term (em:compound "step" ((em:compound "rdf" ((em:iri :order1) (em:iri :status) (em:iri :paid))) (em:compound "clause" ((em:integer "1"))) (em:atom "[]") (em:atom "[]"))) .
proof:record11 em:term (em:compound "step" ((em:compound "not" ((em:compound "rdf" ((em:iri :order1) (em:iri :hold) (em:variable "A"))))) (em:atom "absent") (em:atom "[]") (em:atom "[]"))) .
proof:record12 em:term (em:compound "derived" ((em:compound "rdf" ((em:variable "B") (em:variable "C") (em:variable "D"))) (em:list ((em:compound "rdf" ((em:iri :order2) (em:iri :hold) (em:iri :addressCheck))) (em:compound "rdf" ((em:iri :order1) (em:iri :action) (em:iri :ship))))))) .
proof:record13 em:term (em:compound "searched" ((em:compound "rdf" ((em:iri :order1) (em:iri :hold) (em:variable "E"))) (em:atom "[]"))) .
proof:record14 em:term (em:compound "searched" ((em:compound "rdf" ((em:variable "F") (em:iri :status) (em:iri :paid))) (em:list ((em:compound "rdf" ((em:iri :order1) (em:iri :status) (em:iri :paid))) (em:compound "rdf" ((em:iri :order2) (em:iri :status) (em:iri :paid))))))) .
proof:record15 em:term (em:compound "searched" ((em:compound "rdf" ((em:iri :order2) (em:iri :hold) (em:variable "G"))) (em:list ((em:compound "rdf" ((em:iri :order2) (em:iri :hold) (em:iri :addressCheck))))))) .
proof:record16 em:term (em:compound "searched" ((em:compound "rdf" ((em:variable "H") (em:iri :address) (em:iri :unverified))) (em:list ((em:compound "rdf" ((em:iri :order2) (em:iri :address) (em:iri :unverified))))))) .
