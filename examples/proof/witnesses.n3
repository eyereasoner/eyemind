proof:record12 pe:rule 2 .
proof:record12 pe:binding () .
proof:record12 pe:uses () .
proof:record13 pe:conclusion { _:b1 :status :ready } .
proof:record13 pe:rule 3 .
proof:record13 pe:binding (("Order" :order2) ("Bdelivery" _:b1)) .
proof:record13 pe:uses ({ :order2 :status :paid }) .
proof:record14 pe:derived { ?A ?B ?C } .
proof:record14 pe:answers ({ :order1 :delivery _:b0 } { _:b0 :status :ready } { :order2 :delivery _:b1 } { _:b1 :status :ready }) .
proof:record15 pe:called { ?A :delivery ?B } .
proof:record15 pe:answers ({ :order1 :delivery _:b0 } { :order2 :delivery _:b1 }) .
proof:record16 pe:called { ?C :status :paid } .
proof:record16 pe:answers ({ :order1 :status :paid } { :order2 :status :paid }) .
proof:record17 pe:called { ?D :status :ready } .
proof:record17 pe:answers ({ _:b0 :status :ready } { _:b1 :status :ready }) .
