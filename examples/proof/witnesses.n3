proof:record9 pe:rule 1 .
proof:record9 pe:binding () .
proof:record9 pe:uses () .
proof:record10 pe:conclusion { _:b0 :status :ready } .
proof:record10 pe:rule 3 .
proof:record10 pe:binding (("Order" :order1) ("Bdelivery" _:b0)) .
proof:record10 pe:uses ({ :order1 :status :paid }) .
proof:record11 pe:conclusion { :order2 :delivery _:b1 } .
