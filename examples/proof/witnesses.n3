<urn:eyemind:proof> pe:claims ({ :order1 :delivery _:b0 } { _:b0 :status :ready } { :order2 :delivery _:b1 } { _:b1 :status :ready }) .
proof:record8 pe:conclusion { :order1 :delivery _:b0 } .
proof:record8 pe:rule 3 .
proof:record8 pe:binding (("Order" :order1) ("Bdelivery" _:b0)) .
proof:record8 pe:uses ({ :order1 :status :paid }) .
