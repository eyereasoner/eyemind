proof:record11 em:term (em:compound "step" ((em:compound "rdf" ((em:iri :bob) (em:iri :mother) (em:compound "bnode" ((em:atom "n3") (em:list ((em:atom "y") (em:iri :bob))))))) (em:compound "clause" ((em:integer "4"))) (em:list ((em:compound "=" ((em:atom "Mother") (em:compound "bnode" ((em:atom "n3") (em:list ((em:atom "y") (em:iri :bob))))))))) (em:list ((em:compound "rdf" ((em:iri :bob) (em:iri :hasMother) (em:compound "bnode" ((em:atom "n3") (em:list ((em:atom "y") (em:iri :bob))))))))))) .
