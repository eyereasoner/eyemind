# N3 proof: claims, steps and the complete C1–C10 certificate.
@prefix : <http://example.org/policy#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix em: <https://eyereasoner.github.io/eyemind/proof#> .
@prefix proof: <urn:eyemind:proof#> .

<urn:eyemind:proof> a pe:Proof .
<urn:eyemind:proof> em:format "n3" .
<urn:eyemind:proof> pe:claims ({ { ?x a :Member } => { ?x :mayRead :report } } { :alice :mayRead :report }) .
proof:record7 pe:conclusion { { ?x a :Member } => { ?x :mayRead :report } } .
proof:record7 pe:rule 3 .
proof:record7 pe:binding () .
proof:record7 pe:uses ({ :policy :status :active }) .
proof:record8 pe:conclusion { :policy :status :active } .
proof:record8 pe:rule 1 .
proof:record8 pe:binding () .
proof:record8 pe:uses () .
proof:record9 pe:conclusion { :alice :mayRead :report } .
proof:record9 pe:rule 4 .
proof:record9 pe:binding (("X" :alice)) .
proof:record9 pe:uses ({ :policy :status :active } { :alice a :Member }) .
proof:record10 pe:conclusion { :alice a :Member } .
proof:record10 pe:rule 2 .
proof:record10 pe:binding () .
proof:record10 pe:uses () .
proof:record11 pe:derived { ?A ?B ?C } .
proof:record11 pe:answers ({ { ?x a :Member } => { ?x :mayRead :report } } { :alice :mayRead :report }) .
proof:record12 pe:called { { ?x a :Member } => { ?x :mayRead :report } } .
proof:record12 pe:answers ({ { ?x a :Member } => { ?x :mayRead :report } }) .
proof:record13 pe:called { :policy :status :active } .
proof:record13 pe:answers ({ :policy :status :active }) .
proof:record14 pe:called { ?A a :Member } .
proof:record14 pe:answers ({ :alice a :Member }) .
proof:record15 pe:called { ?B :mayRead :report } .
proof:record15 pe:answers ({ :alice :mayRead :report }) .
