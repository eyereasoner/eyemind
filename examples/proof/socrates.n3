# N3 proof: claims, steps and the complete C1–C10 certificate.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix : <http://example.org/socrates#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix em: <https://eyereasoner.github.io/eyemind/proof#> .
@prefix proof: <urn:eyemind:proof#> .

<urn:eyemind:proof> a pe:Proof .
<urn:eyemind:proof> em:format "n3" .
<urn:eyemind:proof> pe:claims ({ :Socrates a :Mortal }) .
proof:record5 pe:conclusion { :Socrates a :Mortal } .
proof:record5 pe:rule 3 .
proof:record5 pe:binding (("S" :Socrates) ("A" :Human) ("B" :Mortal)) .
proof:record5 pe:uses ({ :Socrates a :Human } { :Human rdfs:subClassOf :Mortal }) .
proof:record6 pe:conclusion { :Socrates a :Human } .
proof:record6 pe:rule 1 .
proof:record6 pe:binding () .
proof:record6 pe:uses () .
proof:record7 pe:conclusion { :Human rdfs:subClassOf :Mortal } .
proof:record7 pe:rule 2 .
proof:record7 pe:binding () .
proof:record7 pe:uses () .
proof:record8 pe:derived { ?A ?B ?C } .
proof:record8 pe:answers ({ :Socrates a :Mortal }) .
proof:record9 pe:called { ?A a ?B } .
proof:record9 pe:answers ({ :Socrates a :Mortal } { :Socrates a :Human }) .
proof:record10 pe:called { :Mortal rdfs:subClassOf ?C } .
proof:record10 pe:answers () .
proof:record11 pe:called { :Human rdfs:subClassOf ?C } .
proof:record11 pe:answers ({ :Human rdfs:subClassOf :Mortal }) .
<urn:eyemind:proof> em:records (proof:record1 proof:record2 proof:record3 proof:record4 proof:record5 proof:record6 proof:record7 proof:record8 proof:record9 proof:record10 proof:record11) .
proof:record1 em:term (em:compound "rdf" ((em:iri :Socrates) (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:iri :Mortal))) .
proof:record2 em:term (em:compound "clause" ((em:integer "1") (em:compound "fact" ((em:compound "rdf" ((em:iri :Socrates) (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:iri :Human))))))) .
proof:record3 em:term (em:compound "clause" ((em:integer "2") (em:compound "fact" ((em:compound "rdf" ((em:iri :Human) (em:iri rdfs:subClassOf) (em:iri :Mortal))))))) .
proof:record4 em:term (em:compound "clause" ((em:integer "3") (em:compound "implies" ((em:list ((em:compound "rdf" ((em:variable "S") (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:variable "A"))) (em:compound "rdf" ((em:variable "A") (em:iri rdfs:subClassOf) (em:variable "B"))))) (em:compound "rdf" ((em:variable "S") (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:variable "B"))))))) .
proof:record5 em:term (em:compound "step" ((em:compound "rdf" ((em:iri :Socrates) (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:iri :Mortal))) (em:compound "clause" ((em:integer "3"))) (em:list ((em:compound "=" ((em:atom "S") (em:iri :Socrates))) (em:compound "=" ((em:atom "A") (em:iri :Human))) (em:compound "=" ((em:atom "B") (em:iri :Mortal))))) (em:list ((em:compound "rdf" ((em:iri :Socrates) (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:iri :Human))) (em:compound "rdf" ((em:iri :Human) (em:iri rdfs:subClassOf) (em:iri :Mortal))))))) .
proof:record6 em:term (em:compound "step" ((em:compound "rdf" ((em:iri :Socrates) (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:iri :Human))) (em:compound "clause" ((em:integer "1"))) (em:atom "[]") (em:atom "[]"))) .
proof:record7 em:term (em:compound "step" ((em:compound "rdf" ((em:iri :Human) (em:iri rdfs:subClassOf) (em:iri :Mortal))) (em:compound "clause" ((em:integer "2"))) (em:atom "[]") (em:atom "[]"))) .
proof:record8 em:term (em:compound "derived" ((em:compound "rdf" ((em:variable "A") (em:variable "B") (em:variable "C"))) (em:list ((em:compound "rdf" ((em:iri :Socrates) (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:iri :Mortal))))))) .
proof:record9 em:term (em:compound "called" ((em:compound "rdf" ((em:variable "A") (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:variable "B"))) (em:list ((em:compound "rdf" ((em:iri :Socrates) (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:iri :Mortal))) (em:compound "rdf" ((em:iri :Socrates) (em:iri <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>) (em:iri :Human))))))) .
proof:record10 em:term (em:compound "called" ((em:compound "rdf" ((em:iri :Mortal) (em:iri rdfs:subClassOf) (em:variable "C"))) (em:atom "[]"))) .
proof:record11 em:term (em:compound "called" ((em:compound "rdf" ((em:iri :Human) (em:iri rdfs:subClassOf) (em:variable "C"))) (em:list ((em:compound "rdf" ((em:iri :Human) (em:iri rdfs:subClassOf) (em:iri :Mortal))))))) .
