# SRL proof: DATA only; claims, steps and the complete C1–C10 certificate.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX : <http://example.org/socrates#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pe: <https://eyereasoner.github.io/pe#>
PREFIX em: <https://eyereasoner.github.io/eyemind/proof#>
PREFIX proof: <urn:eyemind:proof#>

DATA {
<urn:eyemind:proof> a pe:Proof .
<urn:eyemind:proof> em:format "srl" .
<urn:eyemind:proof> pe:claims (<<( :Socrates a :Mortal )>> <<( :Socrates a :Human )>> <<( :Human rdfs:subClassOf :Mortal )>>) .
proof:record9 pe:conclusion <<( :Socrates a :Mortal )>> .
proof:record9 pe:rule 5 .
proof:record9 pe:binding (("X" :Socrates) ("Class" :Human) ("Super" :Mortal)) .
proof:record9 pe:uses (<<( :Socrates a :Human )>> <<( :Human rdfs:subClassOf :Mortal )>>) .
proof:record10 pe:conclusion <<( :Socrates a :Human )>> .
