proof:record11 pe:binding () .
proof:record11 pe:uses () .
proof:record12 pe:conclusion <<( :Socrates a :Human )>> .
proof:record12 pe:rule 2 .
proof:record12 pe:binding () .
proof:record12 pe:uses () .
proof:record13 pe:conclusion <<( :Human rdfs:subClassOf :Mortal )>> .
